{
  "name": "config2ts",
  "version": "2.8.1",
  "description": "Generate type-safe TypeScript from CSV/INI/TOML config tables — inferred types, enums, cross-table references, and a typed asset index, all from one CLI command.",
  "main": "lib/config2ts.js",
  "types": "lib/config2ts.d.ts",
  "bin": {
    "config2ts": "./bin/config2ts"
  },
  "files": [
    "lib/**/*",
    "bin/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "convert": "node ./bin/config2ts -n total.ts -d ./config -o ./config",
    "test": "jest",
    "watch-test": "node_modules/.bin/jest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/livingyang/config2ts.git"
  },
  "author": "livingyang",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/livingyang/config2ts/issues"
  },
  "homepage": "https://github.com/livingyang/config2ts#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "change-case": "^4.1.2",
    "commander": "^9.5.0",
    "d3-dsv": "^3.0.1",
    "ini": "^3.0.1",
    "json5": "^2.2.3",
    "toml": "^4.1.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "browserslist": "^4.28.7",
    "handlebars": "^4.7.9",
    "js-yaml": "^3.14.2",
    "minimatch@^3.0.0": "^3.1.3",
    "picomatch@^2.0.0": "^2.3.2",
    "brace-expansion@^1.0.0": "^1.1.16"
  }
}
