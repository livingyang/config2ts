{
  "name": "config2ts",
  "version": "2.9.1",
  "description": "Generate type-safe TypeScript from CSV/INI/TOML config tables — inferred types, enums, cross-table references, and a typed asset index, all from one CLI command.",
  "main": "lib/config2ts.js",
  "types": "lib/config2ts.d.ts",
  "bin": {
    "config2ts": "./bin/config2ts"
  },
  "files": [
    "lib/**/*",
    "bin/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "convert": "node ./bin/config2ts -n total.ts -d ./config -o ./config",
    "fixtures:regen": "npm run build && node ./scripts/regen-fixtures.js",
    "demo:dev": "npm --prefix website run dev",
    "demo:build": "npm --prefix website run build",
    "pretest": "node -e \"require('fs').rmSync('.test-build',{recursive:true,force:true})\"",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test \".test-build/tests/*.test.js\"",
    "test:coverage": "npm run build && tsc -p tsconfig.test.json && node --test --experimental-test-coverage \".test-build/tests/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/livingyang/config2ts.git"
  },
  "author": "livingyang",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/livingyang/config2ts/issues"
  },
  "homepage": "https://github.com/livingyang/config2ts#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "change-case": "^4.1.2",
    "commander": "^9.5.0",
    "d3-dsv": "^3.0.1",
    "ini": "^3.0.1",
    "json5": "^2.2.3",
    "toml": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  }
}
